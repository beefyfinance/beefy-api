{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": false,
    "isolatedModules": true,
    "pretty": true,
    "declaration": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["./src/**/*"]
}
