{
  "name": "@beefyfinance/blockchain-addressbook",
  "version": "0.57.2",
  "description": "A collection of useful addresses on various chains for defi development",
  "type": "module",
  "types": "./src/address-book/index.ts",
  "exports": {
    ".": {
      "types": "./src/address-book/index.ts",
      "import": "./src/address-book/index.ts"
    },
    "./types/*": {
      "types": "./src/types/*.ts",
      "import": "./src/types/*.ts"
    },
    "./util/*": {
      "types": "./src/util/*.ts",
      "import": "./src/util/*.ts"
    },
    "./*": {
      "types": "./src/address-book/*/index.ts",
      "import": "./src/address-book/*/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/address-book/index.ts",
  "publishConfig": {
    "access": "public",
    "types": "./build-esm/address-book/index.d.ts",
    "main": "./build/address-book/index.js",
    "exports": {
      ".": {
        "types": "./build-esm/address-book/index.d.ts",
        "import": "./build-esm/address-book/index.js",
        "require": "./build/address-book/index.js"
      },
      "./types/*": {
        "types": "./build-esm/types/*.d.ts",
        "import": "./build-esm/types/*.js",
        "require": "./build/types/*.js"
      },
      "./util/*": {
        "types": "./build-esm/util/*.d.ts",
        "import": "./build-esm/util/*.js",
        "require": "./build/util/*.js"
      },
      "./*": {
        "types": "./build-esm/address-book/*/index.d.ts",
        "import": "./build-esm/address-book/*/index.js",
        "require": "./build/address-book/*/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "./build",
    "./build-esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beefyfinance/beefy-api.git"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "scripts": {
    "addChain": "tsx ./scripts/addChain.ts",
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc --project tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > ./build/package.json",
    "build:esm": "tsc --project tsconfig.esm.json && echo '{\"type\": \"module\"}' > ./build-esm/package.json",
    "checksum": "tsx ./scripts/checksum.ts",
    "checkDecimals": "tsx ./scripts/checkDecimals.ts",
    "checkOracles": "tsx ./scripts/checkOracles.ts",
    "checkDuplicates": "tsx ./scripts/checkDuplicates.ts",
    "submit": "pnpm run checksum && pnpm run build && pnpm publish",
    "test": "pnpm run test:ts && pnpm run test:lint",
    "test:ts": "pnpm run test:ts:cjs && pnpm run test:ts:esm",
    "test:ts:cjs": "tsc --noEmit --project tsconfig.cjs.json",
    "test:ts:esm": "tsc --noEmit --project tsconfig.esm.json",
    "test:lint": "pnpm run lint",
    "lint": "pnpm run lint:eslint:check && pnpm run lint:prettier:check",
    "lint:prettier:check": "prettier --check ./{src,scripts}/**/*.ts",
    "lint:prettier:fix": "prettier --write ./{src,scripts}/**/*.ts",
    "lint:eslint:check": "eslint",
    "lint:eslint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@ethereumjs/util": "^9.0.3",
    "@types/node": "^24.10.3",
    "eslint": "^9.5.0",
    "prettier": "^3.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.49.0",
    "viem": "^1.20.2"
  }
}
