{
  "name": "beefy-api",
  "version": "1.0.0",
  "repository": "beefyfinance/beefy-api",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/app.ts",
    "start:prod": "node --enable-source-maps --env-file-if-exists=.env dist/app.mjs",
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json",
    "format:check": "biome format",
    "format:fix": "biome format --fix",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "lint:fix:unsafe": "biome check --fix --unsafe",
    "check-addresses": "node --import tsx scripts/check-addresses.ts",
    "check-addresses:fix": "node --import tsx scripts/check-addresses.ts --fix",
    "add:chain": "node --env-file-if-exists=.env --import tsx scripts/add-chain.ts",
    "add:chain:addressbook": "pnpm --filter @beefyfinance/blockchain-addressbook run addChain",
    "addClm": "node --env-file-if-exists=.env --import tsx scripts/add-clm.ts",
    "checkClms": "node --env-file-if-exists=.env --import tsx scripts/check-clms.ts",
    "addSolidly": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts",
    "check-oracles": "node --env-file-if-exists=.env --import tsx scripts/check-oracles.ts",
    "base:aerodrome:add": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network base --project aerodrome --newFee true --lp",
    "linea:etherex:add": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network linea --project etherex --newFee true --lp",
    "op:velodrome:add": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network optimism --project velodrome --newFee true --lp",
    "zksync:vesync:add": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network zksync --project vesync --newFee true --lp",
    "hyperevm:kittenswap:add": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network hyperevm --project kittenswap --newFee true --lp",
    "lithos": "node --env-file-if-exists=.env --import tsx scripts/add-solidly.ts --network plasma --project lithos --newFee true --lp",
    "eols": "node --env-file-if-exists=.env --import tsx scripts/findEolPools.ts"
  },
  "dependencies": {
    "jsonpath": "catalog:",
    "redis": "catalog:"
  },
  "devDependencies": {
    "@apollo/client": "catalog:",
    "@beefyfinance/blockchain-addressbook": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@koa/cors": "catalog:",
    "@types/async-lock": "catalog:",
    "@types/command-line-args": "catalog:",
    "@types/jsonpath": "catalog:",
    "@types/koa": "catalog:",
    "@types/koa__cors": "catalog:",
    "@types/koa-bodyparser": "catalog:",
    "@types/koa-conditional-get": "catalog:",
    "@types/koa-etag": "catalog:",
    "@types/koa-helmet": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "async-lock": "catalog:",
    "bignumber.js": "catalog:",
    "command-line-args": "catalog:",
    "date-fns": "catalog:",
    "escape-string-regexp": "catalog:",
    "fast-glob": "catalog:",
    "graphql": "catalog:",
    "graphql-tag": "catalog:",
    "koa": "catalog:",
    "koa-bodyparser": "catalog:",
    "koa-conditional-get": "catalog:",
    "koa-etag": "catalog:",
    "koa-helmet": "catalog:",
    "koa-router": "catalog:",
    "lefthook": "catalog:",
    "lodash-es": "catalog:",
    "node-cache": "catalog:",
    "p-queue": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "yargs": "catalog:"
  },
  "packageManager": "pnpm@11.17.0"
}
